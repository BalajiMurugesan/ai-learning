STEP:        step7_curl_ask_batched
DESCRIPTION: curl /ask_batched against live server → W4 6-field Answer
EXPECTED RC: 0
TIMESTAMP:   2026-06-20T19:26:36+00:00
COMMAND:
    out=$(curl -s -i -X POST http://localhost:8000/ask_batched \
                       -H 'Content-Type: application/json' \
                       -d '{"question": "What is RAG?"}')
        echo "$out"
        echo "$out" | head -1 | grep -q '200' || { echo 'EXPECTED 200'; exit 1; }
        body=$(echo "$out" | tail -1)
        for field in content cost_usd retries confidence sources schema_version; do
            echo "$body" | grep -q "\"$field\"" || { echo "MISSING W4 FIELD: $field"; exit 1; }
        done
