DESCRIPTION: Lab §3a Case 4: malformed JSON → 422 or 400
EXPECTED RC: 0
TIMESTAMP:   2026-06-20T18:56:15+00:00
COMMAND:
    out=$(curl -s -i -X POST http://localhost:8000/ask \
                       -H 'Content-Type: application/json' \
                       -d '{"question": "What is the leave policy?"')
        echo "$out"
        if echo "$out" | head -1 | grep -qE '4(00|22)'; then
            echo 'PASS — got 4xx as expected'
        else
            echo 'EXPECTED 422 or 400'
            exit 1
        fi
